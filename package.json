{
  "name": "trainer-relay",
  "type": "module",
  "version": "0.1.0-experimental.11",
  "description": "A Decky Loader plugin for trainer sidecars on supported UniFiDeck shortcuts.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "biome check src tests vitest.config.ts",
    "lint:frontend": "pnpm run lint",
    "format": "biome check --write src tests vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "python scripts/package_trainer_relay.py",
    "test:package": "python -m unittest discover -s tests_packaging -p \"test_*.py\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheussilva421/TrainerRelay.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck"
  ],
  "author": "matheussilva421",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/matheussilva421/TrainerRelay/issues"
  },
  "homepage": "https://github.com/matheussilva421/TrainerRelay#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.54.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode.react": "^4.1.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.8.0"
  },
  "packageManager": "pnpm@11.5.0"
}
